{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    // CommonJS emit. `moduleResolution: Node` resolves our NodeNext-style
    // ".js" relative specifiers back to ".ts" sources. The core has zero
    // runtime dependencies, so dependency `exports`-map resolution is not needed here.
    "module": "CommonJS",
    "moduleResolution": "Node"
  },
  "include": ["src"],
  // The CLI is ESM-only (it reads `import.meta.url` and is shipped as the
  // `js-slim` bin). Library consumers use `dist/esm` or `dist/cjs`.
  "exclude": ["src/cli.ts"]
}
