{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "isolatedModules": true,

    // The e2e/tooling scripts stay plain ESM so `node scripts/*.mjs` works with
    // no build step; `allowJs` lets the tests import them with inferred types.
    "allowJs": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Embed the sources in the maps: `src/` is not published, so without
    // this the shipped maps would point at files consumers do not have.
    "inlineSources": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src", "test", "examples", "scripts", "vitest.config.ts", "vitest.e2e.config.ts"]
}
