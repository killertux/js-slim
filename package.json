{
  "name": "@killertux/js-slim",
  "version": "0.1.0",
  "description": "A typed SLiM protocol harness/server for FitNesse, for Node.js (TypeScript and JavaScript).",
  "type": "module",
  "license": "MIT",
  "author": "Killertux <bruno.canguru@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killertux/js-slim.git"
  },
  "homepage": "https://github.com/killertux/js-slim#readme",
  "bugs": {
    "url": "https://github.com/killertux/js-slim/issues"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13",
      "onFail": "error"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "js-slim": "./dist/esm/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "fitnesse",
    "slim",
    "acceptance-testing",
    "test-harness",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/write-pkg-type.mjs esm module",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-pkg-type.mjs cjs commonjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "e2e": "node scripts/run-fitnesse.mjs",
    "e2e:render": "node scripts/render-fitnesse.mjs",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
